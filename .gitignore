!/prueba-dia/catalogo_dia.json
!/prueba-dia/leccion_clase.json
!/prueba-dia/curso-ejemplo/
/prueba-dia/curso-ejemplo/*
!/prueba-dia/curso-ejemplo/README.md
!/prueba-dia/curso-ejemplo/curso.json
!/prueba-dia/curso-ejemplo/m1_clases.json
!/prueba-dia/curso-ejemplo/m2_casos.json
!/prueba-dia/curso-ejemplo/m3_secuencia.json
!/prueba-dia/plugin-dia/
