# Fotos del celular (botón 📱 de los tutores). Copia este archivo como .env (no se sube al repo) y rellénalo.
# FOTOS_URL: la dirección pública del servicio fotos-servidor/ (p. ej. en Railway).
# FOTOS_CLAVE: la misma TUTOR_CLAVE del servicio (mínimo 24 caracteres; genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))")
FOTOS_URL=
FOTOS_CLAVE=
